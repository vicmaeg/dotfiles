#!/bin/bash
# my-dotfiles:managed — installed by my-omarchy-theme.el.

# Refresh only the Emacs theme.  The upstream omarchy-emacs hook loads its
# full integration, which also changes fonts, shells, server startup, and
# save hooks managed by the personal Emacs configuration.
if command -v emacsclient &>/dev/null && emacsclient --eval t &>/dev/null; then
  emacsclient --no-wait --eval \
    "(when (fboundp 'my/omarchy-apply-theme) (my/omarchy-apply-theme))" \
    &>/dev/null
fi
