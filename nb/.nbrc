#!/usr/bin/env bash

# nb is installed separately; this file only contains portable user settings.
export NB_DIR="${NB_DIR:-$HOME/.nb}"
mkdir -p "$NB_DIR"
export NB_EDITOR="${NB_EDITOR:-nvim}"
export NB_BROWSER="${NB_BROWSER:-w3m}"
export NB_DEFAULT_EXTENSION="${NB_DEFAULT_EXTENSION:-md}"
export NB_DEFAULT_TEMPLATE="${NB_DEFAULT_TEMPLATE:-$HOME/.config/nb/templates/general.md}"

# Keep nb's commit identity isolated from the machine-wide Git configuration.
# On a fresh machine, nb's normal first-run prompt writes to this file.
export GIT_CONFIG_GLOBAL="${NB_GIT_CONFIG_GLOBAL:-$NB_DIR/.gitconfig}"
mkdir -p "$(dirname "$GIT_CONFIG_GLOBAL")"
